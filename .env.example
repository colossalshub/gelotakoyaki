# Local development only. Do not use these values in production.
# Create the role and database to match, then set a long SESSION_SECRET:
#   openssl rand -base64 48

DATABASE_URL=postgresql://gelos:gelos_local_dev@127.0.0.1:5432/gelos_inventory
SHADOW_DATABASE_URL=postgresql://gelos:gelos_local_dev@127.0.0.1:5432/gelos_shadow
SESSION_SECRET=replace-with-the-output-of-openssl-rand-base64-48

# Optional. Production always uses 12. Tests may set 4.
# BCRYPT_ROUNDS=12
